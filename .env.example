# Optional: copy to .env. All paths are relative to the repository root.
WINDFARM_DB=data/windfarm.sqlite3
WINDFARM_TURBINES=config/turbines.example.json
WINDFARM_MODELS=artifacts/models
# Vite proxies /api and /health to this URL during local development.
BACKEND_URL=http://127.0.0.1:8000

# Optional cloud analyst. Numerical forecasts work without NVIDIA credentials.
NVIDIA_AGENT_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Total deadline for the bounded tool-calling conversation (1..120 seconds).
NVIDIA_TIMEOUT_SECONDS=30

# Alternative analyst: enable only ONE provider. API key stays on the backend.
OPENAI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
